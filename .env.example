# ==============================================================================
# ChefTech POS — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your own Supabase project credentials from your Supabase Dashboard:
#    (Settings -> API -> Project URL & Project API Keys -> anon public)
# 3. Never commit your real .env file or service-role keys to source control.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
